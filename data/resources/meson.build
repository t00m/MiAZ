#~ subdir('conf')
#~ subdir('icons')

install_subdir('conf', install_dir: join_paths(get_option('datadir'), meson.project_name(), 'resources' ))
install_subdir('icons', install_dir: join_paths(get_option('datadir'), meson.project_name(), 'resources' ))
install_subdir('plugins', install_dir: join_paths(get_option('datadir'), meson.project_name(), 'resources' ))

# Aggregate plugin requirements index. Generated by
# scripts/devel/collect_plugin_requirements.py; installed when present.
fs = import('fs')
if fs.exists('plugins-requirements.json')
  install_data('plugins-requirements.json',
    install_dir: join_paths(get_option('datadir'), meson.project_name(), 'resources'))
endif
